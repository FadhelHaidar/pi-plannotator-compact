{
  "name": "pi-plannotator-compact",
  "version": "0.1.1",
  "private": true,
  "description": "Standalone Plannotator compact-tracker extension for Pi",
  "author": "backnotprop",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FadhelHaidar/pi-plannotator-compact.git"
  },
  "homepage": "https://github.com/FadhelHaidar/pi-plannotator-compact",
  "bugs": {
    "url": "https://github.com/FadhelHaidar/pi-plannotator-compact/issues"
  },
  "scripts": {
    "postinstall": "node scripts/install-pi-source.mjs",
    "install:dev": "node scripts/install-pi-source.mjs --dependencies-only",
    "dev:hook": "bun run --cwd apps/hook dev",
    "dev:review": "bun run --cwd apps/review dev",
    "build:hook": "bun run --cwd apps/hook build",
    "build:review": "bun run --cwd apps/review build",
    "build:pi": "bun run build:review && bun run build:hook && bun run --cwd apps/pi-extension build",
    "test:pi": "bun test apps/pi-extension",
    "typecheck:pi": "tsc --noEmit -p apps/pi-extension/tsconfig.json",
    "smoke:package": "node scripts/smoke-pi-package.mjs",
    "smoke:discovery": "node scripts/smoke-pi-discovery.mjs artifacts/plannotator-pi-extension.tgz",
    "pack:pi": "bun run build:pi && node scripts/pack-pi.mjs",
    "test:ui": "DOM_TESTS=1 bun test packages/ui packages/editor packages/review-editor packages/guide-viewer"
  },
  "dependencies": {
    "@pierre/diffs": "1.3.6",
    "diff": "^8.0.4",
    "dockview-react": "^5.2.0",
    "dompurify": "^3.4.17",
    "marked": "^17.0.6",
    "sonner": "^2.0.8",
    "@joplin/turndown-plugin-gfm": "^1.0.64",
    "@plannotator/webtui": "0.1.0",
    "chokidar": "^5.0.0",
    "parse5": "^7.3.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/turndown": "^5.0.6",
    "bun-types": "^1.4.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "pi": {
    "extensions": [
      "apps/pi-extension/index.ts"
    ]
  }
}
